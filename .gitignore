# Terraform working directory and downloaded providers
.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan

# Local variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# OS/editor files
.DS_Store
*.swp
*.swo
